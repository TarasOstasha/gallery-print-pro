# Copy to .env and fill with YOUR Supabase project (Settings → API / Database).
# This replaces Lovable Cloud Supabase.

# From Supabase → Project Settings → General
SUPABASE_PROJECT_ID=

# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# From Supabase → Project Settings → API
# REQUIRED: service_role secret (JWT with role "service_role") OR sb_secret_…
# Do NOT paste the anon / publishable key here — Storage uploads will be blocked.
# In the dashboard this is labeled "service_role" / "secret" (not "anon" / "publishable").
SUPABASE_SERVICE_ROLE_KEY=

# Vite client (same values as above  required for browser)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Days after a paid order is completed/shipped before photos become eligible
# for automatic retention cleanup (manual Admin delete is required for now).
PHOTO_RETENTION_DAYS=30

# Stripe (Dashboard → Developers → API keys)
# Prefer test keys (pk_test_… / sk_test_…) until checkout is verified end-to-end.
# SECRET_KEY / PUBLISHABLE_KEY are also accepted for compatibility.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Or legacy names:
# SECRET_KEY=
# PUBLISHABLE_KEY=
# Webhook signing secret (Dashboard → Developers → Webhooks → endpoint → Signing secret)
# Endpoint URL: https://YOUR_DOMAIN/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Optional public site URL used if the browser origin is unavailable
# APP_URL=https://your-domain.com
