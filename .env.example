# Copy to .env and fill with YOUR Supabase project (Settings → API / Database).
# This replaces Lovable Cloud Supabase.

# From Supabase → Project Settings → General
SUPABASE_PROJECT_ID=

# From Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# From Supabase → Project Settings → API
# Use service_role (secret) or sb_secret_…  NOT anon/publishable.
# Orders persist via DATABASE_URL even if this is wrong; Storage uploads need the real key.
SUPABASE_SERVICE_ROLE_KEY=

# Vite client (same values as above  required for browser)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# From Supabase → Project Settings → Database → Connection string (URI)
# Use the "Session mode" or direct connection string (postgres://...)
# Needed to run SQL migrations from this repo.
DATABASE_URL=
LOVABLE_DB_MIGRATION_URL=
